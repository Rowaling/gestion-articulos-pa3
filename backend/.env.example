# Cadena de conexión de MongoDB Atlas (reemplaza USUARIO y CONTRASEÑA)
MONGODB_URI=mongodb+srv://USUARIO:CONTRASEÑA@cluster0.xxxxx.mongodb.net/articulosdb?appName=Cluster0
PORT=3000

# Clave secreta para firmar los JWT. Usa una cadena larga y aleatoria, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria
JWT_EXPIRES_IN=1h

# Orígenes permitidos por CORS, separados por coma (sin barra final).
# En desarrollo: Angular (4200) y React (5173). En producción: las URLs de Vercel.
CORS_ORIGIN=http://localhost:4200,http://localhost:5173

# Contraseñas de las cuentas de prueba que crea seed.js (solo para demo)
SEED_ADMIN_PASSWORD=Admin123*
SEED_USER_PASSWORD=Usuario123*
